import { Button, CheckBox, ListView, ProgressIndicator, LineEdit, Palette } from "std-widgets.slint";

export struct MapItem {
    label: string,
    source: string,
}

export struct ResultRow {
    header: bool,
    missing: bool,
    text: string,
    detail: string,
}

export struct CleanRow {
    text: string,
    detail: string,
    checked: bool,
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    height: 40px;
    border-radius: 8px;
    background: active ? Palette.accent-background : (ta.has-hover ? Palette.control-background : transparent);
    Text {
        x: 14px;
        text: root.text;
        color: root.active ? Palette.accent-foreground : Palette.foreground;
        font-size: 14px;
        font-weight: root.active ? 700 : 400;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Card inherits Rectangle {
    background: Palette.control-background;
    border-radius: 10px;
    border-width: 1px;
    border-color: Palette.border;
}

component DirRow inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    in-out property <string> path;
    callback browse;
    callback changed(string);
    spacing: 4px;
    Text { text: root.title; font-weight: 700; color: Palette.foreground; }
    Text { text: root.hint; font-size: 12px; color: Palette.foreground.with-alpha(0.6); wrap: word-wrap; }
    HorizontalLayout {
        spacing: 8px;
        edit := LineEdit {
            text <=> root.path;
            placeholder-text: "Not set";
            accepted(t) => { root.changed(t); }
        }
        Button { text: "Browse…"; clicked => { root.browse(); } }
        Button { text: "Clear"; clicked => { root.path = ""; root.changed(""); } }
    }
}

export component MainWindow inherits Window {
    title: "OMSI-Tools-NG";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 800px;
    min-height: 520px;
    background: Palette.background;

    // navigation: 0 maps, 1 cleanup, 2 settings
    in-out property <int> page: 0;

    // settings
    in-out property <string> omsi-dir;
    in-out property <string> neo-dir;
    in-out property <string> open-dir;
    in-out property <string> cleanup-dir;
    in property <string> config-path;
    callback browse-dir(int);
    callback dir-changed(int, string);

    // maps / scan
    in property <[MapItem]> maps;
    in-out property <int> selected-map: -1;
    in property <bool> busy;
    in property <float> progress;
    in property <string> status;
    in property <string> summary;
    in property <[ResultRow]> results;
    in-out property <bool> show-found: false;
    callback scan(int);
    callback cancel;
    callback reload-maps;
    callback show-found-changed(bool);

    // cleanup
    in property <[CleanRow]> clean-rows;
    in property <string> clean-summary;
    in property <string> clean-selected;
    in property <string> pending-action;
    callback analyze;
    callback clean-toggled(int, bool);
    callback clean-select-all(bool);
    callback request-move;
    callback request-recycle;
    callback confirm-action;
    callback cancel-action;

    HorizontalLayout {
        // ---- sidebar ----
        Rectangle {
            width: 210px;
            background: Palette.control-background;
            VerticalLayout {
                padding: 14px;
                spacing: 6px;
                alignment: start;
                Text {
                    text: "OMSI-Tools-NG";
                    font-size: 18px;
                    font-weight: 800;
                    color: Palette.foreground;
                }
                Text {
                    text: "Map scan & cleanup";
                    font-size: 12px;
                    color: Palette.foreground.with-alpha(0.6);
                }
                Rectangle { height: 14px; }
                NavItem { text: "Maps"; active: root.page == 0; clicked => { root.page = 0; } }
                NavItem { text: "Cleanup"; active: root.page == 1; clicked => { root.page = 1; } }
                NavItem { text: "Settings"; active: root.page == 2; clicked => { root.page = 2; } }
            }
        }

        // ---- pages ----
        Rectangle {
            // Maps
            if root.page == 0: HorizontalLayout {
                padding: 16px;
                spacing: 16px;
                Card {
                    width: 330px;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        HorizontalLayout {
                            Text {
                                text: "Maps (" + root.maps.length + ")";
                                font-weight: 700;
                                font-size: 15px;
                                color: Palette.foreground;
                                vertical-alignment: center;
                            }
                            Rectangle { }
                            Button { text: "Reload"; enabled: !root.busy; clicked => { root.reload-maps(); } }
                        }
                        if root.maps.length == 0: Text {
                            text: "No maps found. Set your OMSI directories in Settings.";
                            wrap: word-wrap;
                            color: Palette.foreground.with-alpha(0.7);
                        }
                        ListView {
                            for m[i] in root.maps: Rectangle {
                                height: 46px;
                                border-radius: 6px;
                                background: root.selected-map == i ? Palette.accent-background : (mta.has-hover ? Palette.background : transparent);
                                VerticalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: center;
                                    Text {
                                        text: m.label;
                                        overflow: elide;
                                        color: root.selected-map == i ? Palette.accent-foreground : Palette.foreground;
                                    }
                                    Text {
                                        text: m.source;
                                        font-size: 11px;
                                        color: (root.selected-map == i ? Palette.accent-foreground : Palette.foreground).with-alpha(0.65);
                                    }
                                }
                                mta := TouchArea { clicked => { if !root.busy { root.selected-map = i; } } }
                            }
                        }
                    }
                }
                VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 10px;
                        Button {
                            text: "Scan selected map";
                            primary: true;
                            enabled: !root.busy && root.selected-map >= 0;
                            clicked => { root.scan(root.selected-map); }
                        }
                        Button { text: "Cancel"; enabled: root.busy; clicked => { root.cancel(); } }
                        Rectangle { }
                        CheckBox {
                            text: "Show found files";
                            checked <=> root.show-found;
                            toggled => { root.show-found-changed(self.checked); }
                        }
                    }
                    ProgressIndicator {
                        progress: root.progress;
                        indeterminate: root.busy && root.progress < 0;
                    }
                    Text {
                        text: root.status;
                        color: Palette.foreground.with-alpha(0.7);
                        overflow: elide;
                    }
                    if root.summary != "": Text {
                        text: root.summary;
                        font-weight: 700;
                        font-size: 15px;
                        color: Palette.foreground;
                        wrap: word-wrap;
                    }
                    Card {
                        ListView {
                            for r in root.results: Rectangle {
                                height: r.header ? 38px : (r.detail != "" ? 48px : 30px);
                                background: r.header ? Palette.background.with-alpha(0.6) : transparent;
                                VerticalLayout {
                                    padding-left: r.header ? 12px : 26px;
                                    padding-right: 12px;
                                    alignment: center;
                                    Text {
                                        text: r.text;
                                        overflow: elide;
                                        font-weight: r.header ? 700 : 400;
                                        color: r.header ? Palette.foreground : (r.missing ? #e5484d : #30a46c);
                                    }
                                    if r.detail != "": Text {
                                        text: r.detail;
                                        font-size: 11px;
                                        overflow: elide;
                                        color: Palette.foreground.with-alpha(0.6);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Cleanup
            if root.page == 1: VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text { text: "Cleanup"; font-size: 20px; font-weight: 800; color: Palette.foreground; }
                Text {
                    text: "Finds Sceneryobjects, Splines and Vehicles folders that no map of any configured directory uses. Nothing is changed until you confirm; folders are moved or sent to the recycle bin, never hard-deleted.";
                    wrap: word-wrap;
                    color: Palette.foreground.with-alpha(0.7);
                }
                HorizontalLayout {
                    spacing: 10px;
                    Button {
                        text: "Analyze all maps";
                        primary: true;
                        enabled: !root.busy;
                        clicked => { root.analyze(); }
                    }
                    Button { text: "Cancel"; enabled: root.busy; clicked => { root.cancel(); } }
                    Rectangle { }
                    Button { text: "Select all"; enabled: !root.busy && root.clean-rows.length > 0; clicked => { root.clean-select-all(true); } }
                    Button { text: "Select none"; enabled: !root.busy && root.clean-rows.length > 0; clicked => { root.clean-select-all(false); } }
                }
                ProgressIndicator { progress: root.progress; indeterminate: root.busy && root.progress < 0; }
                Text { text: root.status; color: Palette.foreground.with-alpha(0.7); overflow: elide; }
                if root.clean-summary != "": Text {
                    text: root.clean-summary;
                    font-weight: 700;
                    color: Palette.foreground;
                    wrap: word-wrap;
                }
                Card {
                    ListView {
                        for r[i] in root.clean-rows: Rectangle {
                            height: 52px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                CheckBox {
                                    checked: r.checked;
                                    enabled: !root.busy;
                                    toggled => { root.clean-toggled(i, self.checked); }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: r.text; overflow: elide; color: Palette.foreground; }
                                    Text { text: r.detail; font-size: 11px; overflow: elide; color: Palette.foreground.with-alpha(0.6); }
                                }
                            }
                        }
                    }
                }
                if root.pending-action != "": Card {
                    height: 64px;
                    background: Palette.accent-background.with-alpha(0.15);
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 10px;
                        Text {
                            text: root.pending-action;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            color: Palette.foreground;
                            horizontal-stretch: 1;
                        }
                        Button { text: "Confirm"; primary: true; clicked => { root.confirm-action(); } }
                        Button { text: "Cancel"; clicked => { root.cancel-action(); } }
                    }
                }
                if root.pending-action == "": HorizontalLayout {
                    spacing: 10px;
                    Text { text: root.clean-selected; vertical-alignment: center; color: Palette.foreground; }
                    Rectangle { }
                    Button { text: "Move to folder…"; enabled: !root.busy; clicked => { root.request-move(); } }
                    Button { text: "Move to recycle bin"; enabled: !root.busy; clicked => { root.request-recycle(); } }
                }
            }

            // Settings
            if root.page == 2: VerticalLayout {
                padding: 16px;
                spacing: 16px;
                alignment: start;
                Text { text: "Settings"; font-size: 20px; font-weight: 800; color: Palette.foreground; }
                Card {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 16px;
                        DirRow {
                            title: "OMSI 2 directory";
                            hint: "Main installation, the folder that contains Maps, Sceneryobjects, Vehicles…";
                            path <=> root.omsi-dir;
                            browse => { root.browse-dir(0); }
                            changed(t) => { root.dir-changed(0, t); }
                        }
                        DirRow {
                            title: "neoOMSI directory (optional)";
                            hint: "Content found in any configured directory counts as present for every map.";
                            path <=> root.neo-dir;
                            browse => { root.browse-dir(1); }
                            changed(t) => { root.dir-changed(1, t); }
                        }
                        DirRow {
                            title: "openOMSI directory (optional)";
                            hint: "";
                            path <=> root.open-dir;
                            browse => { root.browse-dir(2); }
                            changed(t) => { root.dir-changed(2, t); }
                        }
                        DirRow {
                            title: "Cleanup destination (optional)";
                            hint: "Unused folders are moved here by the cleanup instead of being deleted.";
                            path <=> root.cleanup-dir;
                            browse => { root.browse-dir(3); }
                            changed(t) => { root.dir-changed(3, t); }
                        }
                    }
                }
                Text {
                    text: "Settings are saved automatically to " + root.config-path;
                    font-size: 12px;
                    color: Palette.foreground.with-alpha(0.6);
                    wrap: word-wrap;
                }
            }
        }
    }
}
