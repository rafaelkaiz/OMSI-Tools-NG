import { Button, CheckBox, ListView, ProgressIndicator, LineEdit, ComboBox, Palette } from "std-widgets.slint";

export struct CountRow {
    name: string,
    total: string,
    missing: string,
    bad: bool,
}

export struct ResultRow {
    header: bool,
    missing: bool,
    text: string,
    detail: string,
}

export struct CleanRow {
    text: string,
    detail: string,
    checked: bool,
}

// Light and dark palettes. `dark` follows the system until the user toggles it.
export global Theme {
    out property <bool> dark: Palette.color-scheme != ColorScheme.light;
    public function set-dark(d: bool) { Palette.color-scheme = d ? ColorScheme.dark : ColorScheme.light; }
    out property <color> bg: dark ? #1c1d20 : #eceef1;
    out property <color> panel: dark ? #26282c : #ffffff;
    out property <color> panel-border: dark ? #383b41 : #d3d7dd;
    out property <color> tile: dark ? #30333a : #f3f5f8;
    out property <color> tile-hover: dark ? #3b3f47 : #e4e8ee;
    out property <color> text: dark ? #ececee : #1d2026;
    out property <color> muted: dark ? #9da0a8 : #5f6670;
    out property <color> accent: #1f7aec;
    out property <color> accent-text: #ffffff;
    out property <color> ok: dark ? #3dd68c : #1a8a54;
    out property <color> bad: dark ? #ff6369 : #d12d35;
}

// Logo: magnifying glass over a rounded tile, with an "NG" badge.
component Logo inherits Rectangle {
    in property <length> size: 40px;
    width: size;
    height: size;
    border-radius: size * 0.24;
    background: @linear-gradient(135deg, #2b8cff 0%, #1556c4 100%);
    Path {
        x: parent.width * 0.16;
        y: parent.height * 0.14;
        width: parent.width * 0.6;
        height: parent.height * 0.6;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: white;
        fill-rule: evenodd;
        commands: "M10 2a8 8 0 1 0 4.9 14.3l5.4 5.4 1.8-1.8-5.4-5.4A8 8 0 0 0 10 2z M10 4.6a5.4 5.4 0 1 1 0 10.8 5.4 5.4 0 0 1 0-10.8z";
    }
    Rectangle {
        x: parent.width * 0.52;
        y: parent.height * 0.6;
        width: parent.width * 0.44;
        height: parent.height * 0.34;
        border-radius: parent.height * 0.1;
        background: #ffb020;
        Text {
            text: "NG";
            color: #1c1d20;
            font-size: root.size * 0.2;
            font-weight: 900;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component Card inherits Rectangle {
    background: Theme.panel;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.panel-border;
}

component Section inherits VerticalLayout {
    in property <string> title;
    spacing: 6px;
    Text { text: root.title; color: Theme.muted; font-size: 13px; font-weight: 600; }
    Card {
        height: 128px;
        HorizontalLayout {
            padding: 14px;
            spacing: 12px;
            alignment: start;
            @children
        }
    }
}

component HomeTile inherits Rectangle {
    in property <string> text;
    in property <string> glyph; // SVG path commands, 24x24
    in property <color> glyph-color: Theme.accent;
    callback clicked;
    width: 108px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.tile-hover : Theme.tile;
    border-width: 1px;
    border-color: Theme.panel-border;
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        alignment: center;
        HorizontalLayout { alignment: center; Path {
            width: 44px;
            height: 44px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: root.glyph;
            fill: root.glyph-color;
            fill-rule: evenodd;
        } }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: 13px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <string> badge;
    in property <color> badge-color: Theme.bad;
    callback clicked;
    height: 34px;
    border-radius: 6px;
    background: active ? Theme.accent : (ta.has-hover ? Theme.tile-hover : transparent);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;
        Text {
            text: root.text;
            color: root.active ? Theme.accent-text : Theme.text;
            vertical-alignment: center;
            font-size: 13px;
            font-weight: root.active ? 700 : 400;
        }
        if root.badge != "": Rectangle {
            width: max(18px, badge-text.preferred-width + 10px);
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 9px;
            background: root.badge-color;
            badge-text := Text {
                text: root.badge;
                color: white;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component DirRow inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    in-out property <string> path;
    callback browse;
    callback changed(string);
    spacing: 4px;
    Text { text: root.title; font-weight: 700; color: Theme.text; }
    if root.hint != "": Text { text: root.hint; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
    HorizontalLayout {
        spacing: 8px;
        LineEdit {
            text <=> root.path;
            placeholder-text: @tr("" => "Not set");
            accepted(t) => { root.changed(t); }
        }
        Button { text: @tr("" => "Browse…"); clicked => { root.browse(); } }
        Button { text: @tr("" => "Clear"); clicked => { root.path = ""; root.changed(""); } }
    }
}

component PageHeader inherits Rectangle {
    in property <string> title;
    callback back;
    callback toggle-theme;
    height: 56px;
    background: Theme.panel;
    border-width: 0px;
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.panel-border;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        VerticalLayout { alignment: center; Button { text: @tr("" => "← Home"); clicked => { root.back(); } } }
        Text { text: root.title; font-size: 17px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
        Rectangle { }
        VerticalLayout { alignment: center; Button { text: Theme.dark ? @tr("" => "Light theme") : @tr("" => "Dark theme"); clicked => { root.toggle-theme(); } } }
    }
}

export component MainWindow inherits Window {
    title: "OMSI-Tools-NG";
    icon: @image-url("logo.svg");
    preferred-width: 980px;
    preferred-height: 700px;
    min-width: 760px;
    min-height: 520px;
    background: Theme.bg;

    // 0 home, 1 map verification, 2 cleanup, 3 settings
    in-out property <int> page: 0;
    callback theme-saved(bool);
    public function flip-theme() { Theme.set-dark(!Theme.dark); root.theme-saved(Theme.dark); }

    // settings
    in-out property <string> omsi-dir;
    in-out property <string> neo-dir;
    in-out property <string> open-dir;
    in-out property <string> cleanup-dir;
    in property <string> config-path;
    callback browse-dir(int);
    callback dir-changed(int, string);
    in property <[string]> language-names;
    in-out property <int> lang-index: 0;
    callback language-changed(int);

    // map verification
    in property <[string]> map-names;
    in-out property <int> selected-map: -1;
    in property <image> map-picture;
    in property <bool> has-picture;
    in property <bool> busy;
    in property <float> progress;
    in property <string> status;
    in property <string> summary;
    in property <[CountRow]> counts;
    in property <[ResultRow]> tab-rows;
    in-out property <int> tab: 0;
    in-out property <bool> show-found: false;
    callback map-selected(int);
    callback scan(int);
    callback cancel;
    callback reload-maps;
    callback tab-changed(int);
    callback show-found-changed(bool);

    // cleanup
    in property <[CleanRow]> clean-rows;
    in property <string> clean-summary;
    in property <string> clean-selected;
    in-out property <int> clean-tab: 0;
    in property <[string]> clean-badges;
    callback clean-tab-changed(int);
    in property <string> pending-action;
    callback analyze;
    callback clean-toggled(int, bool);
    callback clean-select-all(bool);
    callback request-move;
    callback request-recycle;
    callback confirm-action;
    callback cancel-action;

    // ---------------- HOME ----------------
    if root.page == 0: VerticalLayout {
        padding: 24px;
        spacing: 16px;
        HorizontalLayout {
            spacing: 14px;
            VerticalLayout { alignment: center; Logo { size: 52px; } }
            VerticalLayout {
                alignment: center;
                Text { text: "OMSI-Tools-NG"; font-size: 24px; font-weight: 800; color: Theme.text; }
                Text { text: @tr("" => "Map verification and cleanup for OMSI 2, neoOMSI and openOMSI"); font-size: 13px; color: Theme.muted; }
            }
            Rectangle { }
            VerticalLayout { alignment: center; Button { text: Theme.dark ? @tr("" => "Light theme") : @tr("" => "Dark theme"); clicked => { root.flip-theme(); } } }
        }
        Section {
            title: @tr("" => "Troubleshooting");
            HomeTile {
                text: @tr("" => "Map verification");
                glyph-color: Theme.ok;
                glyph: "M10 2a8 8 0 1 0 4.9 14.3l5.4 5.4 1.8-1.8-5.4-5.4A8 8 0 0 0 10 2z M10 4.6a5.4 5.4 0 1 1 0 10.8 5.4 5.4 0 0 1 0-10.8z";
                clicked => { root.page = 1; }
            }
        }
        Section {
            title: @tr("" => "Disk memory");
            HomeTile {
                text: @tr("" => "Cleanup");
                glyph-color: #e8a317;
                glyph: "M20.6 2.4a1.6 1.6 0 0 0-2.3 0L11.5 9.2l2.3 2.3 6.8-6.8a1.6 1.6 0 0 0 0-2.3z M10.3 10.4C8 10.9 6.4 12.6 6 15c-.2 1.5-.9 2.7-2.4 3.7-.6.4-.3 1.3.4 1.3 1.4 0 3-.2 4.5-.8 3-1.2 5-3.5 5.6-6.3z";
                clicked => { root.page = 2; }
            }
        }
        Section {
            title: @tr("" => "Configuration");
            HomeTile {
                text: @tr("" => "Settings");
                glyph-color: Theme.muted;
                glyph: "M3 6h11v2H3z M18 6h3v2h-3z M14 4h4v6h-4z M3 16h3v2H3z M10 16h11v2H10z M6 14h4v6H6z";
                clicked => { root.page = 3; }
            }
        }
        Rectangle { }
        Text {
            text: @tr("" => "Based on OMSI-Tools by pietr26 (GPLv2).") + " " + root.status;
            font-size: 12px;
            color: Theme.muted;
            font-italic: true;
            wrap: word-wrap;
        }
    }

    // ---------------- MAP VERIFICATION ----------------
    if root.page == 1: VerticalLayout {
        PageHeader { title: @tr("" => "Map verification"); back => { root.page = 0; } toggle-theme => { root.flip-theme(); } }
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 8px;
                ComboBox {
                    model: root.map-names;
                    current-index <=> root.selected-map;
                    enabled: !root.busy && root.map-names.length > 0;
                    selected => { root.map-selected(self.current-index); }
                    horizontal-stretch: 1;
                }
                Button { text: @tr("" => "Reload"); enabled: !root.busy; clicked => { root.reload-maps(); } }
                if root.busy: Button { text: @tr("" => "Cancel"); clicked => { root.cancel(); } }
                Button {
                    text: @tr("" => "Start!");
                    primary: true;
                    enabled: !root.busy && root.selected-map >= 0;
                    clicked => { root.scan(root.selected-map); }
                }
            }
            HorizontalLayout {
                spacing: 4px;
                TabButton { text: @tr("" => "Overview"); active: root.tab == 0; clicked => { root.tab = 0; root.tab-changed(0); } }
                TabButton { text: @tr("" => "Tiles"); active: root.tab == 1; badge: root.counts[0].bad ? root.counts[0].missing : ""; clicked => { root.tab = 1; root.tab-changed(1); } }
                TabButton { text: @tr("" => "Textures"); active: root.tab == 2; badge: root.counts[1].bad ? root.counts[1].missing : ""; clicked => { root.tab = 2; root.tab-changed(2); } }
                TabButton { text: @tr("" => "Sceneryobjects"); active: root.tab == 3; badge: root.counts[2].bad ? root.counts[2].missing : ""; clicked => { root.tab = 3; root.tab-changed(3); } }
                TabButton { text: @tr("" => "Splines"); active: root.tab == 4; badge: root.counts[3].bad ? root.counts[3].missing : ""; clicked => { root.tab = 4; root.tab-changed(4); } }
                TabButton { text: @tr("" => "Vehicles"); active: root.tab == 5; badge: root.counts[4].bad ? root.counts[4].missing : ""; clicked => { root.tab = 5; root.tab-changed(5); } }
                TabButton { text: @tr("" => "Humans"); active: root.tab == 6; badge: root.counts[5].bad ? root.counts[5].missing : ""; clicked => { root.tab = 6; root.tab-changed(6); } }
                Rectangle { }
            }
            Card {
                vertical-stretch: 1;
                if root.tab == 0: HorizontalLayout {
                    padding: 18px;
                    spacing: 20px;
                    VerticalLayout {
                        spacing: 8px;
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            Text { text: ""; width: 130px; }
                            Text { text: @tr("" => "Total"); color: Theme.muted; font-size: 13px; width: 158px; }
                            Text { text: @tr("" => "Missing"); color: Theme.muted; font-size: 13px; horizontal-stretch: 1; }
                        }
                        for c in root.counts: HorizontalLayout {
                            spacing: 8px;
                            Text { text: c.name + ":"; width: 130px; color: Theme.text; vertical-alignment: center; }
                            Rectangle {
                                height: 34px;
                                border-radius: 6px;
                                background: Theme.tile;
                                width: 150px;
                                Text { text: c.total; color: Theme.text; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Rectangle {
                                height: 34px;
                                border-radius: 6px;
                                background: c.bad ? Theme.bad.with-alpha(0.18) : Theme.tile;
                                width: 150px;
                                Text {
                                    text: c.missing;
                                    color: c.bad ? Theme.bad : Theme.text;
                                    font-size: 14px;
                                    font-weight: c.bad ? 700 : 400;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        if root.summary != "": Text { text: root.summary; color: Theme.text; font-weight: 600; wrap: word-wrap; }
                        Rectangle { }
                    }
                    Rectangle {
                        width: 250px;
                        border-radius: 8px;
                        clip: true;
                        background: Theme.tile;
                        if root.has-picture: Image { source: root.map-picture; image-fit: contain; width: parent.width; height: parent.height; }
                        if !root.has-picture: Text {
                            text: @tr("" => "No picture");
                            color: Theme.muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.tab != 0: VerticalLayout {
                    HorizontalLayout {
                        padding: 10px;
                        Text {
                            text: root.summary;
                            color: Theme.muted;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        CheckBox {
                            text: @tr("" => "Show found files");
                            checked <=> root.show-found;
                            toggled => { root.show-found-changed(self.checked); }
                        }
                    }
                    if root.tab-rows.length == 0: Text {
                        text: root.summary == "" ? @tr("" => "Press Start! to start the verification.") : "No missing files in this category.";
                        color: Theme.muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        vertical-stretch: 1;
                    }
                    ListView {
                        for r in root.tab-rows: Rectangle {
                            height: r.header ? 36px : (r.detail != "" ? 48px : 30px);
                            background: r.header ? Theme.tile : transparent;
                            VerticalLayout {
                                padding-left: r.header ? 14px : 22px;
                                padding-right: 12px;
                                alignment: center;
                                Text {
                                    text: r.text;
                                    overflow: elide;
                                    font-weight: r.header ? 700 : 400;
                                    color: r.header ? Theme.text : (r.missing ? Theme.bad : Theme.ok);
                                }
                                if r.detail != "": Text {
                                    text: r.detail;
                                    font-size: 11px;
                                    overflow: elide;
                                    color: Theme.muted;
                                }
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                Text { text: root.status; color: Theme.muted; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                if root.busy: ProgressIndicator { progress: root.progress; width: 220px; }
            }
        }
    }

    // ---------------- CLEANUP ----------------
    if root.page == 2: VerticalLayout {
        PageHeader { title: @tr("" => "Cleanup"); back => { root.page = 0; } toggle-theme => { root.flip-theme(); } }
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            Text {
                text: @tr("" => "Finds Sceneryobjects, Splines and Vehicles folders that no map of any configured directory uses. Nothing is changed until you confirm; folders are moved or sent to the recycle bin, never hard-deleted.");
                wrap: word-wrap;
                color: Theme.muted;
            }
            HorizontalLayout {
                spacing: 8px;
                Button { text: @tr("" => "Analyze all maps"); primary: true; enabled: !root.busy; clicked => { root.analyze(); } }
                if root.busy: Button { text: @tr("" => "Cancel"); clicked => { root.cancel(); } }
                Rectangle { }
                Button { text: @tr("" => "Select all"); enabled: !root.busy && root.clean-rows.length > 0; clicked => { root.clean-select-all(true); } }
                Button { text: @tr("" => "Select none"); enabled: !root.busy && root.clean-rows.length > 0; clicked => { root.clean-select-all(false); } }
            }
            if root.clean-summary != "": Text { text: root.clean-summary; font-weight: 700; color: Theme.text; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 4px;
                TabButton { text: @tr("" => "Sceneryobjects"); active: root.clean-tab == 0; badge: root.clean-badges[0]; badge-color: Theme.accent; clicked => { root.clean-tab = 0; root.clean-tab-changed(0); } }
                TabButton { text: @tr("" => "Splines"); active: root.clean-tab == 1; badge: root.clean-badges[1]; badge-color: Theme.accent; clicked => { root.clean-tab = 1; root.clean-tab-changed(1); } }
                TabButton { text: @tr("" => "Vehicles"); active: root.clean-tab == 2; badge: root.clean-badges[2]; badge-color: Theme.accent; clicked => { root.clean-tab = 2; root.clean-tab-changed(2); } }
                Rectangle { }
            }
            Card {
                vertical-stretch: 1;
                ListView {
                    for r[i] in root.clean-rows: Rectangle {
                        height: 52px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;
                            CheckBox {
                                checked: r.checked;
                                enabled: !root.busy;
                                toggled => { root.clean-toggled(i, self.checked); }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text { text: r.text; overflow: elide; color: Theme.text; }
                                Text { text: r.detail; font-size: 11px; overflow: elide; color: Theme.muted; }
                            }
                        }
                    }
                }
            }
            if root.pending-action != "": Card {
                height: 64px;
                background: Theme.accent.with-alpha(0.15);
                HorizontalLayout {
                    padding: 12px;
                    spacing: 10px;
                    Text { text: root.pending-action; wrap: word-wrap; vertical-alignment: center; color: Theme.text; horizontal-stretch: 1; }
                    Button { text: @tr("" => "Confirm"); primary: true; clicked => { root.confirm-action(); } }
                    Button { text: @tr("" => "Cancel"); clicked => { root.cancel-action(); } }
                }
            }
            if root.pending-action == "": HorizontalLayout {
                spacing: 8px;
                Text { text: root.clean-selected; vertical-alignment: center; color: Theme.text; }
                Rectangle { }
                Button { text: @tr("" => "Move to folder…"); enabled: !root.busy; clicked => { root.request-move(); } }
                Button { text: @tr("" => "Move to recycle bin"); enabled: !root.busy; clicked => { root.request-recycle(); } }
            }
            HorizontalLayout {
                spacing: 12px;
                Text { text: root.status; color: Theme.muted; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                if root.busy: ProgressIndicator { progress: root.progress; width: 220px; }
            }
        }
    }

    // ---------------- SETTINGS ----------------
    if root.page == 3: VerticalLayout {
        PageHeader { title: @tr("" => "Settings"); back => { root.page = 0; } toggle-theme => { root.flip-theme(); } }
        VerticalLayout {
            padding: 16px;
            spacing: 14px;
            alignment: start;
            Card {
                HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Text { text: @tr("" => "Language"); font-weight: 700; color: Theme.text; vertical-alignment: center; }
                    ComboBox {
                        model: root.language-names;
                        current-index <=> root.lang-index;
                        selected => { root.language-changed(self.current-index); }
                        width: 220px;
                    }
                    Rectangle { }
                }
            }
            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 16px;
                    DirRow {
                        title: @tr("" => "OMSI 2 directory");
                        hint: @tr("" => "Main installation, the folder that contains Maps, Sceneryobjects, Vehicles…");
                        path <=> root.omsi-dir;
                        browse => { root.browse-dir(0); }
                        changed(t) => { root.dir-changed(0, t); }
                    }
                    DirRow {
                        title: @tr("" => "neoOMSI directory (optional)");
                        hint: @tr("" => "Content found in any configured directory counts as present for every map.");
                        path <=> root.neo-dir;
                        browse => { root.browse-dir(1); }
                        changed(t) => { root.dir-changed(1, t); }
                    }
                    DirRow {
                        title: @tr("" => "openOMSI directory (optional)");
                        path <=> root.open-dir;
                        browse => { root.browse-dir(2); }
                        changed(t) => { root.dir-changed(2, t); }
                    }
                    DirRow {
                        title: @tr("" => "Cleanup destination (optional)");
                        hint: @tr("" => "Unused folders are moved here by the cleanup instead of being deleted.");
                        path <=> root.cleanup-dir;
                        browse => { root.browse-dir(3); }
                        changed(t) => { root.dir-changed(3, t); }
                    }
                }
            }
            Text {
                text: @tr("" => "Settings are saved automatically to {}", root.config-path);
                font-size: 12px;
                color: Theme.muted;
                wrap: word-wrap;
            }
        }
    }
}
